---
import VerticalLayout from '../layouts/VerticalLayout.astro';
import { verticals, getVertical } from '../data/verticals';
import { getCaseStudiesForVertical } from '../data/case-studies';

export function getStaticPaths() {
  return verticals.map(v => ({ params: { vertical: v.slug } }));
}

const { vertical: slug } = Astro.params;
const vertical = getVertical(slug!);
if (!vertical) return Astro.redirect('/');

const studies = getCaseStudiesForVertical(slug!);
---

<VerticalLayout vertical={vertical} studies={studies} />
