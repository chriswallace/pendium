---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { verticals } from '../data/verticals';
import { caseStudies } from '../data/case-studies';

const featuredStudies = caseStudies.slice(0, 4);

const services = [
  {
    name: 'AI Assistant Design & Deployment',
    slug: 'ai-assistants',
    accent: 'var(--accent-2)',
    description: 'Custom AI assistants for internal teams, customer-facing products, and embedded product features — designed as products, not chatbots.',
    points: [
      'Behavioral specification & persona architecture',
      'Prompt engineering & system design',
      'Tool and CRM integration',
      'Evaluation framework & quality benchmarking',
    ],
  },
  {
    name: 'Knowledge Management Systems',
    slug: 'knowledge-management',
    accent: 'var(--accent-1)',
    description: 'RAG pipelines, vector databases, and search interfaces that make organizational knowledge findable, trustworthy, and AI-accessible.',
    points: [
      'Knowledge audit & taxonomy design',
      'Document ingestion & embedding pipelines',
      'Retrieval interfaces & Slack bots',
      'Governance model & freshness policy',
    ],
  },
  {
    name: 'Design & Tech Automation',
    slug: 'automation',
    accent: 'var(--accent-3)',
    description: 'Intelligent automation for creative and technical operations — pipelines that integrate with Figma, Adobe, CMSs, and dev environments.',
    points: [
      'Workflow analysis & opportunity mapping',
      'AI pipeline design for image, copy & code',
      'Brand compliance automation',
      'Training & adoption support',
    ],
  },
];
---

<BaseLayout title="Pendium — AI Implementation for Companies That Build Things">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__orb" aria-hidden="true">
        <div class="ascii-layer">
          <pre class="ascii ascii-bg" id="ascii-bg"></pre>
        </div>
        <div class="ascii-layer">
          <pre class="ascii ascii-fg" id="ascii"></pre>
        </div>
      </div>
      <div class="hero__content">
        <span class="label label--accent">AI Implementation</span>
        <h1 class="mt-16">
          From AI ambition<br/>
          to AI <span class="gradient-text">capability.</span>
        </h1>
        <p class="hero__desc mt-24">
          Pendium designs AI assistants, knowledge management systems, and automation services
          for technology, media, and internet businesses.
          We close the gap between what AI can do and what your organization actually gets out of it.
        </p>
        <div class="hero__actions mt-32">
          <a href="/contact" class="btn btn--primary">Start a project</a>
          <a href="/work" class="btn">See the work</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Services -->
  <section class="services">
    <div class="container">
      <div class="section-header">
        <span class="label">Services</span>
        <h2>Three things we do well.</h2>
        <p>Each service is distinct enough to stand alone. Together, they cover the full scope of practical AI implementation.</p>
      </div>

      <div class="services__grid">
        {services.map(s => (
          <div class="services__card">
            <span class="services__accent" style={`color: ${s.accent}`}>{s.name}</span>
            <p class="services__desc">{s.description}</p>
            <ul class="services__points">
              {s.points.map(p => <li>{p}</li>)}
            </ul>
            <a href={`/services/${s.slug}`} class="services__link">
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Industries -->
  <section class="industries">
    <div class="container">
      <div class="section-header">
        <span class="label">Industries</span>
        <h2>Built for companies that move fast.</h2>
        <p>We work across eight verticals. Each gets a tailored approach — not the same playbook renamed.</p>
      </div>

      <div class="industries__grid">
        {verticals.map(v => (
          <a href={`/${v.slug}`} class="industries__card">
            <h3 class="industries__name">{v.shortName}</h3>
            <p class="industries__tagline">{v.tagline}</p>
            <span class="industries__cta">See how →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Work -->
  <section class="work-preview">
    <div class="container">
      <div class="section-header">
        <span class="label">Work</span>
        <h2>What engagements look like.</h2>
        <p>Illustrative examples representing the shape and scale of typical Pendium engagements.</p>
      </div>

      <div class="work-preview__grid">
        {featuredStudies.map(study => (
          <CaseStudyCard study={study} compact />
        ))}
      </div>

      <div class="mt-48">
        <a href="/work" class="btn">View all case studies →</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-section__inner">
      <div>
        <span class="label">Get started</span>
        <h2 class="mt-16">Not sure where to start?<br/>That's what the Discovery Sprint is for.</h2>
        <p class="mt-16">
          Two weeks. A clear-eyed audit of your AI opportunity, a prioritized roadmap, and a plan you can act on.
          Fixed price, no ongoing commitment.
        </p>
        <div class="mt-32">
          <a href="/contact" class="btn btn--primary">Book a Discovery Sprint — from $8,000</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding-top: calc(var(--nav-h) + 80px);
    padding-bottom: 80px;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero__orb {
    width: 100%;
    aspect-ratio: 1;
    max-width: 480px;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 80px rgba(0,0,0,0.7);
    justify-self: center;
  }

  .hero__orb::before {
    content: "";
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 45%, transparent 70%);
    mix-blend-mode: screen;
    opacity: 0.5;
    pointer-events: none;
    z-index: 1;
  }

  .ascii-layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .ascii {
    margin: 0;
    line-height: 1;
    letter-spacing: 0;
    font-size: 12px;
    white-space: pre;
    user-select: none;
  }

  .ascii-bg { color: #3a3a3a; opacity: 0.85; }

  .ascii-fg {
    color: transparent;
    background: linear-gradient(90deg, #7ef9ff, #b36bff, #ff6bd6, #ffd36b);
    background-size: 240% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: spectrum 12s ease-in-out infinite;
  }

  .hero__desc {
    font-size: 15px;
    line-height: 1.8;
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ── Services ── */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .services__card {
    background: var(--bg);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .services__accent {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .services__desc {
    font-size: 14px;
    line-height: 1.7;
    max-width: none;
  }

  .services__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .services__points li {
    font-size: 13px;
    color: var(--text-muted);
    padding-left: 16px;
    position: relative;
  }

  .services__points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-dim);
  }

  .services__link {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: auto;
    transition: color 0.15s;
  }

  .services__link:hover { color: var(--accent-1); }

  /* ── Industries ── */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .industries__card {
    background: var(--bg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background 0.2s;
    text-decoration: none;
  }

  .industries__card:hover { background: var(--bg-subtle); }

  .industries__name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .industries__tagline {
    font-size: 12px;
    color: var(--text-muted);
    max-width: none;
    flex: 1;
    line-height: 1.6;
  }

  .industries__cta {
    font-size: 12px;
    color: var(--text-dim);
    transition: color 0.15s;
  }

  .industries__card:hover .industries__cta { color: var(--accent-1); }

  /* ── Work preview ── */
  .work-preview__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
  }

  /* ── CTA Section ── */
  .cta-section { background: var(--bg-subtle); }

  .cta-section__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .industries__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: 48px; }
    .hero__orb { max-width: 300px; order: -1; }
    .services__grid { grid-template-columns: 1fr; }
    .industries__grid { grid-template-columns: 1fr; }
    .work-preview__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const asciiEl = document.getElementById("ascii") as HTMLPreElement;
  const asciiBgEl = document.getElementById("ascii-bg") as HTMLPreElement;
  const orbEl = document.querySelector(".hero__orb") as HTMLElement;

  if (asciiEl && asciiBgEl && orbEl) {
    let cols = 0, rows = 0;
    let cell = { w: 8, h: 12 };
    const drops: {x:number;y:number;vy:number;char:string}[] = [];
    const barChars = ["|", ":", "!", "i"];
    const peakChars = ["^", "*", "+"];
    let lastTime = 0;

    function measureCell() {
      const probe = document.createElement("span");
      probe.textContent = "M";
      probe.style.fontSize = getComputedStyle(asciiEl).fontSize;
      probe.style.visibility = "hidden";
      probe.style.position = "absolute";
      document.body.appendChild(probe);
      const rect = probe.getBoundingClientRect();
      cell = { w: rect.width, h: rect.height };
      document.body.removeChild(probe);
    }

    function resizeGrid() {
      const { width, height } = orbEl.getBoundingClientRect();
      const fontSize = Math.max(11, Math.floor(width / 28)) + "px";
      asciiEl.style.fontSize = fontSize;
      asciiEl.style.lineHeight = "1";
      asciiBgEl.style.fontSize = fontSize;
      asciiBgEl.style.lineHeight = "1";
      measureCell();
      cols = Math.max(8, Math.floor(width / cell.w));
      rows = Math.max(8, Math.floor(height / cell.h));
    }

    function addDrop(x: number, y: number) {
      drops.push({ x, y, vy: 0.5 + Math.random() * 0.8, char: Math.random() > 0.5 ? "." : "`" });
    }

    function updateDrops() {
      for (let i = drops.length - 1; i >= 0; i--) {
        drops[i].y += drops[i].vy;
        if (drops[i].y >= rows) drops.splice(i, 1);
      }
    }

    function renderFrame(time: number) {
      const delta = Math.min(0.05, (time - lastTime) / 1000);
      lastTime = time;
      const t = time * 0.0012;
      const grid = Array.from({ length: rows }, () => Array.from({ length: cols }, () => " "));
      const bgGrid = Array.from({ length: rows }, () => Array.from({ length: cols }, () => " "));
      const base = rows * 0.5, amp = rows * 0.22, amp2 = rows * 0.12;
      const freq = 0.35, freq2 = 0.18;
      const ambientChars = [".", ":", "*", "'"];
      const driftX = Math.sin(time * 0.00018) * 4.5;
      const driftY = Math.cos(time * 0.00014) * 3.5;

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const px = x + driftX, py = y + driftY;
          const field = Math.sin(px * 0.28 + t * 0.6) + Math.sin(py * 0.22 - t * 0.45) + Math.sin((px + py) * 0.12 + t * 0.3);
          if (field > 1.15) bgGrid[y][x] = ambientChars[(x + y) % ambientChars.length];
          else if (field > 0.85) bgGrid[y][x] = ambientChars[(x + y + 1) % ambientChars.length];
          else if (field < -1.35) bgGrid[y][x] = ".";
        }
      }

      for (let x = 0; x < cols; x += 2) {
        const magnitude = Math.abs(Math.sin(x * freq + t) * amp + Math.sin(x * freq2 - t * 1.4) * amp2);
        const height = Math.max(1, Math.round(magnitude));
        const center = Math.round(base);
        const top = Math.max(0, center - height);
        const bottom = Math.min(rows - 1, center + height);
        for (let y = bottom; y >= top; y--) {
          const gap = Math.sin(x * 0.6 + y * 0.22 + t * 1.2);
          if (gap > 0.92) continue;
          const wash = Math.sin(t * 1.8 + x * 0.35 - y * 0.2);
          if (y === top || y === bottom) grid[y][x] = peakChars[Math.floor((wash + 1) * 0.5 * peakChars.length) % peakChars.length];
          else if (wash > 0.35) grid[y][x] = barChars[(x + y) % barChars.length];
          else grid[y][x] = barChars[0];
        }
        if (Math.random() < 0.004 * delta * 60) addDrop(x, top - 1);
      }

      updateDrops();
      drops.forEach(drop => {
        if (drop.y >= 0 && drop.y < rows) grid[Math.floor(drop.y)][drop.x] = drop.char;
      });

      asciiBgEl.textContent = bgGrid.map(r => r.join("")).join("\n");
      asciiEl.textContent = grid.map(r => r.join("")).join("\n");
      requestAnimationFrame(renderFrame);
    }

    resizeGrid();
    window.addEventListener("resize", resizeGrid);
    requestAnimationFrame(renderFrame);
  }
</script>
