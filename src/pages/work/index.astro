---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/case-studies';
import { verticals } from '../../data/verticals';

const verticalMap = Object.fromEntries(verticals.map(v => [v.slug, v.shortName]));
---

<BaseLayout
  title="Work — Pendium"
  description="Example AI implementation engagements across technology, media, e-commerce, marketing, legal, financial services, healthcare, and education."
>
  <section class="page-hero">
    <div class="container">
      <span class="label label--accent">Work</span>
      <h1 class="mt-16">What engagements look like.</h1>
      <p class="mt-16">
        Illustrative examples representing the shape, scope, and outcomes of typical Pendium engagements.
        Sixteen case studies across eight industries.
      </p>
    </div>
  </section>

  <hr class="divider" />

  {verticals.map(v => {
    const studies = caseStudies.filter(cs => cs.vertical === v.slug);
    return studies.length > 0 ? (
      <section class="work-section">
        <div class="container">
          <div class="work-section__header">
            <span class="label">{v.shortName}</span>
          </div>
          <div class="work-section__grid">
            {studies.map(study => (
              <CaseStudyCard study={study} />
            ))}
          </div>
        </div>
      </section>
      <hr class="divider" />
    ) : null;
  })}

  <section class="work-cta">
    <div class="container">
      <span class="label">Ready?</span>
      <h2 class="mt-16">Start with a Discovery Sprint.</h2>
      <p class="mt-16">Two weeks, fixed price. A clear-eyed audit, prioritized roadmap, and a plan you can act on.</p>
      <div class="mt-32">
        <a href="/contact" class="btn btn--primary">Get in touch →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-h) + 80px);
    padding-bottom: 80px;
  }

  .page-hero p {
    font-size: 16px;
    max-width: 60ch;
  }

  .work-section {
    padding: 80px 0;
  }

  .work-section__header {
    margin-bottom: 40px;
  }

  .work-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .work-cta {
    padding: 96px 0;
    background: var(--bg-subtle);
  }

  @media (max-width: 768px) {
    .work-section__grid { grid-template-columns: 1fr; }
  }
</style>
