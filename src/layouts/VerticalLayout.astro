---
import BaseLayout from './BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import type { Vertical } from '../data/verticals';
import type { CaseStudy } from '../data/case-studies';

interface Props {
  vertical: Vertical;
  studies: CaseStudy[];
}

const { vertical, studies } = Astro.props;

const serviceAccents: Record<string, string> = {
  'AI Assistant Design & Deployment': 'var(--accent-2)',
  'Knowledge Management Systems': 'var(--accent-1)',
  'Design & Tech Automation': 'var(--accent-3)',
};
---

<BaseLayout
  title={`${vertical.name} AI Implementation — Pendium`}
  description={vertical.description}
>
  <!-- Hero -->
  <section class="v-hero">
    <div class="container">
      <a href="/" class="v-hero__back">← Pendium</a>
      <div class="v-hero__content">
        <span class="label label--accent">{vertical.shortName}</span>
        <h1 class="mt-16">{vertical.tagline}</h1>
        <p class="v-hero__desc mt-24">{vertical.description}</p>
        <div class="mt-32">
          <a href="/contact" class="btn btn--primary">Start a Discovery Sprint</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Pain Points + Opportunities -->
  <section class="v-problems">
    <div class="container v-problems__inner">
      <div class="v-problems__col">
        <span class="label">Where the friction lives</span>
        <ul class="v-list mt-24">
          {vertical.painPoints.map(p => <li>{p}</li>)}
        </ul>
      </div>
      <div class="v-problems__col">
        <span class="label">What AI makes possible</span>
        <ul class="v-list v-list--positive mt-24">
          {vertical.opportunities.map(o => <li>{o}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Services -->
  <section class="v-services">
    <div class="container">
      <div class="section-header">
        <span class="label">Services applied</span>
        <h2>What we build for {vertical.shortName} companies.</h2>
      </div>

      <div class="v-services__grid">
        {vertical.primaryServices.map(s => (
          <div class="v-services__card">
            <span class="v-services__accent" style={`color: ${serviceAccents[s] ?? 'var(--text-muted)'}`}>{s}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Case Studies -->
  {studies.length > 0 && (
    <section class="v-work">
      <div class="container">
        <div class="section-header">
          <span class="label">Example engagements</span>
          <h2>What this looks like in practice.</h2>
          <p>Illustrative examples of typical Pendium engagements in {vertical.shortName}.</p>
        </div>

        <div class="v-work__grid">
          {studies.map(study => (
            <CaseStudyCard study={study} />
          ))}
        </div>
      </div>
    </section>
  )}

  <hr class="divider" />

  <!-- CTA -->
  <section class="v-cta">
    <div class="container v-cta__inner">
      <span class="label">Next step</span>
      <h2 class="mt-16">Start with a Discovery Sprint.</h2>
      <p class="mt-16">
        Two weeks, fixed price ($8K–$15K). We audit your current state, map AI opportunities specific to your business,
        and hand you a prioritized roadmap. No commitment beyond the sprint.
      </p>
      <div class="mt-32">
        <a href="/contact" class="btn btn--primary">Get in touch →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .v-hero {
    padding-top: calc(var(--nav-h) + 80px);
    padding-bottom: 80px;
  }

  .v-hero__back {
    display: inline-block;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 48px;
    transition: color 0.15s;
  }

  .v-hero__back:hover { color: var(--text); }

  .v-hero__content {
    max-width: 720px;
  }

  .v-hero__content h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .v-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    max-width: 60ch;
  }

  /* ── Pain / Opportunity ── */
  .v-problems__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .v-problems__col > .label {
    display: block;
  }

  .v-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .v-list li {
    font-size: 14px;
    color: var(--text-muted);
    padding-left: 20px;
    position: relative;
    line-height: 1.6;
  }

  .v-list li::before {
    position: absolute;
    left: 0;
    color: var(--text-dim);
  }

  .v-list:not(.v-list--positive) li::before { content: '✕'; }
  .v-list--positive li { color: var(--text); }
  .v-list--positive li::before { content: '→'; color: var(--accent-1); }

  /* ── Services ── */
  .v-services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .v-services__card {
    background: var(--bg);
    padding: 40px;
  }

  .v-services__accent {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 16px;
  }

  /* ── Work ── */
  .v-work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
  }

  /* ── CTA ── */
  .v-cta {
    background: var(--bg-subtle);
  }

  .v-cta__inner {
    max-width: 640px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .v-problems__inner { grid-template-columns: 1fr; gap: 48px; }
    .v-services__grid { grid-template-columns: 1fr; }
    .v-work__grid { grid-template-columns: 1fr; }
  }
</style>
