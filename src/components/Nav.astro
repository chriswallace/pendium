---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];

const verticalLinks = [
  { href: '/technology-saas', label: 'Technology & SaaS' },
  { href: '/media-publishing', label: 'Media & Publishing' },
  { href: '/ecommerce-retail', label: 'E-Commerce & Retail' },
  { href: '/marketing-agencies', label: 'Marketing & Agencies' },
  { href: '/legal-professional', label: 'Legal & Professional' },
  { href: '/financial-services', label: 'Financial Services' },
  { href: '/healthcare-healthtech', label: 'Healthcare & HealthTech' },
  { href: '/education-edtech', label: 'Education & EdTech' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav" aria-label="Main navigation">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Pendium home">
      Pendium
    </a>

    <div class="nav__links">
      <div class="nav__item nav__item--dropdown">
        <button class="nav__link nav__dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Industries
        </button>
        <div class="nav__dropdown" role="menu">
          {verticalLinks.map(link => (
            <a href={link.href} class="nav__dropdown-item" role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>

      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': currentPath.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}

      <a href="/contact" class="btn btn--primary nav__cta">Start a project</a>
    </div>

    <button class="nav__hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    background: rgba(0,0,0,0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .nav__logo {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text);
    flex-shrink: 0;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s;
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--text);
  }

  .nav__dropdown-trigger::after {
    content: '▾';
    font-size: 10px;
  }

  .nav__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 8px 0;
    z-index: 200;
  }

  .nav__item--dropdown:hover .nav__dropdown,
  .nav__item--dropdown:focus-within .nav__dropdown {
    display: block;
  }

  .nav__dropdown-item {
    display: block;
    padding: 8px 20px;
    font-size: 12px;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
  }

  .nav__dropdown-item:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav__cta {
    margin-left: 12px;
    padding: 8px 18px;
  }

  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav__hamburger span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--text);
  }

  @media (max-width: 768px) {
    .nav__links {
      display: none;
      position: fixed;
      inset: var(--nav-h) 0 0;
      background: var(--bg);
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
      gap: 0;
      overflow-y: auto;
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__link {
      width: 100%;
      padding: 14px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .nav__dropdown {
      position: static;
      border: none;
      padding: 8px 0 8px 16px;
      background: transparent;
    }

    .nav__item--dropdown:hover .nav__dropdown,
    .nav__item--dropdown:focus-within .nav__dropdown {
      display: block;
    }

    .nav__cta {
      margin: 24px 0 0;
    }

    .nav__hamburger {
      display: flex;
    }
  }
</style>

<script>
  const hamburger = document.querySelector('.nav__hamburger') as HTMLButtonElement;
  const links = document.querySelector('.nav__links') as HTMLElement;

  hamburger?.addEventListener('click', () => {
    const isOpen = links.classList.toggle('is-open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
</script>
