---
import type { CaseStudy } from '../data/case-studies';

interface Props {
  study: CaseStudy;
  compact?: boolean;
}

const { study, compact = false } = Astro.props;

const serviceColors: Record<string, string> = {
  'AI Assistant Design & Deployment': 'var(--accent-2)',
  'Knowledge Management Systems': 'var(--accent-1)',
  'Design & Tech Automation': 'var(--accent-3)',
};
---

<article class:list={['case-study-card', { 'case-study-card--compact': compact }]}>
  <div class="case-study-card__services">
    {study.services.map(s => (
      <span class="case-study-card__service-tag" style={`color: ${serviceColors[s] ?? 'var(--text-muted)'}`}>
        {s}
      </span>
    ))}
  </div>

  <h3 class="case-study-card__title">{study.title}</h3>
  <p class="case-study-card__client">{study.clientType}</p>

  {!compact && (
    <>
      <div class="case-study-card__section">
        <span class="label">Challenge</span>
        <p>{study.challenge}</p>
      </div>

      <div class="case-study-card__section">
        <span class="label">Engagement</span>
        <p>{study.engagement}</p>
      </div>

      <div class="case-study-card__section">
        <span class="label">Outcome</span>
        <p>{study.outcome}</p>
      </div>
    </>
  )}

  {compact && (
    <p class="case-study-card__outcome">{study.outcome}</p>
  )}

  {study.metrics.length > 0 && (
    <div class="case-study-card__metrics">
      {study.metrics.map(m => (
        <div class="case-study-card__metric">
          <span class="case-study-card__metric-value">{m.value}</span>
          <span class="case-study-card__metric-label">{m.label}</span>
        </div>
      ))}
    </div>
  )}

  <div class="case-study-card__meta">
    <span class="label">{study.duration}</span>
  </div>
</article>

<style>
  .case-study-card {
    padding: 40px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .case-study-card__services {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .case-study-card__service-tag {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .case-study-card__client {
    font-size: 12px;
    color: var(--text-muted);
    max-width: none;
    margin-top: -12px;
  }

  .case-study-card__section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .case-study-card__section p {
    font-size: 13px;
    line-height: 1.7;
    max-width: none;
  }

  .case-study-card__outcome {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: none;
  }

  .case-study-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding-top: 8px;
    border-top: 1px solid var(--border-subtle);
  }

  .case-study-card__metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .case-study-card__metric-value {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .case-study-card__metric-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .case-study-card__meta {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }
</style>
