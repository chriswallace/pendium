---
const verticals = [
  { href: '/technology-saas', label: 'Technology & SaaS' },
  { href: '/media-publishing', label: 'Media & Publishing' },
  { href: '/ecommerce-retail', label: 'E-Commerce & Retail' },
  { href: '/marketing-agencies', label: 'Marketing & Agencies' },
  { href: '/legal-professional', label: 'Legal & Professional' },
  { href: '/financial-services', label: 'Financial Services' },
  { href: '/healthcare-healthtech', label: 'Healthcare & HealthTech' },
  { href: '/education-edtech', label: 'Education & EdTech' },
];

const services = [
  { href: '/services/ai-assistants', label: 'AI Assistant Design' },
  { href: '/services/knowledge-management', label: 'Knowledge Management' },
  { href: '/services/automation', label: 'Design & Tech Automation' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo">Pendium</a>
        <p class="footer__tagline">AI implementation for companies that build things.</p>
        <a href="mailto:hello@pendium.co" class="footer__email">hello@pendium.co</a>
      </div>

      <div class="footer__nav">
        <div class="footer__col">
          <span class="label">Services</span>
          <ul>
            {services.map(s => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        </div>

        <div class="footer__col">
          <span class="label">Industries</span>
          <ul>
            {verticals.map(v => <li><a href={v.href}>{v.label}</a></li>)}
          </ul>
        </div>

        <div class="footer__col">
          <span class="label">Company</span>
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <div class="footer__bottom">
      <span class="footer__copy">© {new Date().getFullYear()} Pendium.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 80px 0 40px;
    background: var(--bg);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    margin-bottom: 64px;
  }

  .footer__logo {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  .footer__tagline {
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-muted);
    max-width: none;
  }

  .footer__email {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .footer__email:hover {
    color: var(--accent-1);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .footer__col .label {
    display: block;
    margin-bottom: 16px;
  }

  .footer__col ul {
    list-style: none;
  }

  .footer__col li {
    margin-bottom: 10px;
  }

  .footer__col a {
    font-size: 13px;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .footer__col a:hover {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
  }

  .footer__copy {
    font-size: 12px;
    color: var(--text-dim);
  }

  @media (max-width: 768px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 480px) {
    .footer__nav {
      grid-template-columns: 1fr;
    }
  }
</style>
